# ==========================================
# SATISIUM UI - LOCAL ENVIRONMENT SETUP
# ==========================================
# Instructions: Copy this file to '.env.local' and fill in the values below.

# --- POSTHOG ANALYTICS ---
# Found in Project Settings -> Project API Key
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN="phc_your_posthog_token_here"
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- UPSTASH REDIS (For Telemetry & Rate Limiting) ---
# Found in Upstash Console -> Database -> REST API
UPSTASH_REDIS_REST_URL="https://your-upstash-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_token_here"

# --- CLOUDINARY (For Media Optimization) ---
# Your Cloudinary cloud name for serving optimized videos/images
NEXT_PUBLIC_CLOUDINARY_NAME="your_cloud_name"

# --- GITHUB (For fetching last modified dates on Docs) ---
# Create a fine-grained Personal Access Token (Read-Only) in Developer Settings
GIT_TOKEN="github_pat_your_token_here"

# --- SEARCH ENGINE VERIFICATION (Optional for local dev) ---
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""